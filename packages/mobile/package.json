{
  "name": "@abc-earlysteps/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@abc-earlysteps/shared": "file:../shared",
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "testRegex": ".*\\.spec\\.tsx?$",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "module": "commonjs",
            "esModuleInterop": true,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@abc-earlysteps/shared$": "<rootDir>/../shared/src/index.ts",
      "^react-native$": "<rootDir>/__mocks__/react-native.ts"
    }
  }
}
