# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=abc_earlysteps
DB_SSL=false
DB_POOL_MAX=20

# Redis (ElastiCache compatible)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_CLUSTER_ENABLED=false

# Rate Limiting Defaults
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_IP_WINDOW=60
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_LOGIN_PER_EMAIL_WINDOW=60
RATE_LIMIT_LOGIN_BURST=30
RATE_LIMIT_LOGIN_BURST_WINDOW=600
RATE_LIMIT_PASSWORD_RESET_PER_IP=20
RATE_LIMIT_PASSWORD_RESET_PER_IP_WINDOW=900
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL=5
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL_WINDOW=900
RATE_LIMIT_EMAIL_VERIFY_RESEND_PER_IP=10
RATE_LIMIT_EMAIL_VERIFY_RESEND_PER_IP_WINDOW=900
RATE_LIMIT_EMAIL_VERIFY_RESEND_PER_EMAIL=3
RATE_LIMIT_EMAIL_VERIFY_RESEND_PER_EMAIL_WINDOW=900
RATE_LIMIT_REFRESH_TOKEN_PER_USER=30
RATE_LIMIT_REFRESH_TOKEN_PER_USER_WINDOW=60
RATE_LIMIT_PUBLIC_PER_IP=120
RATE_LIMIT_PUBLIC_PER_IP_WINDOW=60
RATE_LIMIT_SENSITIVE_PER_USER=300
RATE_LIMIT_SENSITIVE_PER_USER_WINDOW=60

# Password Hashing
BCRYPT_ROUNDS=12

# Security
TRUSTED_PROXY_IPS=
AUTH_FAILURE_THRESHOLD=5

# Logging
LOG_LEVEL=info
LOG_REDACT_FIELDS=password,token,authorization,cookie,email,refreshToken,accessToken
