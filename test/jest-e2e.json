{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@config/(.*)$": "<rootDir>/../src/config/$1",
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@redis/(.*)$": "<rootDir>/../src/redis/$1",
    "^@health/(.*)$": "<rootDir>/../src/health/$1"
  }
}
